@startuml
skinparam linetype ortho
hide empty members
skinparam ArrowThickness 0.5

title <size:18>lab8-client — Клиентская часть (JavaFX)</size>

package "Client Module" {
  class Client
  class ClientConnectionModule
  class AuthController
  class MainController
  class ProductFormDialog
  class CanvasRenderer
  class LocaleManager
}

package "Common" as COMMON {
  class Request <<record>>
  class Response <<record>>
  enum CommandType
  class Product <<record>>
  class Coordinates <<record>>
  class Location <<record>>
  class Person <<record>>
  enum UnitOfMeasure
}

' ==================== Relationships ====================
Client --> ClientConnectionModule
Client --> AuthController
Client --> MainController
Client --> LocaleManager

AuthController --> ClientConnectionModule
AuthController --> Request

MainController --> ClientConnectionModule
MainController --> Request
MainController --> Product
MainController --> UnitOfMeasure
MainController --> CanvasRenderer
MainController --> ProductFormDialog

ProductFormDialog --> Product
ProductFormDialog --> Coordinates
ProductFormDialog --> Person
ProductFormDialog --> Location
ProductFormDialog --> UnitOfMeasure

CanvasRenderer --> Product

ClientConnectionModule --> Request
ClientConnectionModule --> Response

@enduml
